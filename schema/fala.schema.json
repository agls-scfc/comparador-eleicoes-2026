{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fala.schema.json",
  "title": "Fala",
  "description": "Declaração pública do candidato, com fonte e data. O site não classifica a fala como coerente ou divergente do plano.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "candidato", "eixo", "citacao", "data", "veiculo", "tipo_fonte", "url"],
  "properties": {
    "id": { "type": "string", "pattern": "^f-(pt|pl)-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$" },
    "candidato": { "enum": ["lula", "flavio-bolsonaro"] },
    "eixo": { "type": "string" },
    "topico": { "type": ["string", "null"] },
    "citacao": { "type": "string", "minLength": 12, "maxLength": 400 },
    "data": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "veiculo": { "type": "string", "minLength": 2 },
    "tipo_fonte": { "enum": ["entrevista", "debate", "discurso", "sabatina", "rede_social", "coletiva", "outro"] },
    "contexto": { "type": ["string", "null"] },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "timestamp": { "type": ["string", "null"], "description": "Posição no vídeo/áudio, ex.: 12:34." },
    "proposta_ids": { "type": "array", "items": { "type": "string" } }
  }
}
