---
import Base from "../../layouts/Base.astro";
import Proposta from "../../components/Proposta.astro";
import { eixos, documentos, visivel, CANDIDATOS, PREVIEW } from "../../lib/dados";

export function getStaticPaths() {
  return eixos().map((e) => ({ params: { eixo: e.id }, props: { eixo: e } }));
}
const { eixo } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = documentos();
const camadas = [
  { chave: "propostas", nome: "Propostas dos planos" },
  { chave: "falas", nome: "Falas dos candidatos" },
  { chave: "acoes", nome: "Ações e votos" },
] as const;
const mostrarPropostas = visivel(eixo.status.propostas);
const doTopico = (cand: string, topico: string, tipo: string) =>
  eixo.propostas.filter((p: any) => p.candidato === cand && p.topico === topico && p.tipo === tipo);
const resultados = (cand: string) => eixo.propostas.filter((p: any) => p.candidato === cand && p.tipo === "resultado_declarado");
---
<Base titulo={eixo.titulo} descricao={eixo.descricao}>
  <p><a href={base}>← Todos os eixos</a></p>
  <h1>{eixo.titulo}</h1>
  <p class="lead">{eixo.descricao}</p>

  <ul class="status" aria-label="Situação de cada parte">
    {camadas.map((c) => (
      <li>{c.nome}: {eixo.status[c.chave] === "publicado"
        ? <span class="chip">publicado</span>
        : <span class="chip aviso">em preparação</span>}</li>
    ))}
  </ul>

  {PREVIEW && <div class="aviso-caixa">Pré-visualização: mostrando também o que ainda não foi publicado.</div>}

  <div class="barra">
    <button type="button" id="inverter" aria-pressed="false">⇄ Inverter os lados</button>
  </div>

  <h2>Propostas dos planos</h2>
  {!mostrarPropostas && <div class="aviso-caixa">As propostas deste eixo estão <strong>em preparação</strong> e ainda não foram publicadas.</div>}

  {mostrarPropostas && eixo.topicos.map((t: any) => {
    const colunas = CANDIDATOS.map((c) => ({ c, itens: doTopico(c.id, t.id, "compromisso") }));
    if (colunas.every((x) => x.itens.length === 0)) return null;
    return (
      <section class="topico" aria-labelledby={`t-${t.id}`}>
        <h3 id={`t-${t.id}`}>{t.titulo}</h3>
        <div class="lados">
          {colunas.map(({ c, itens }) => (
            <div class="lado" data-cand={c.id}>
              <p class="quem"><strong>{c.nome}</strong> <span class="chip">{c.partido}</span></p>
              {itens.length
                ? itens.map((p: any) => <Proposta proposta={p} docs={docs} />)
                : <p class="vazio">Nenhuma proposta registrada neste tópico.</p>}
            </div>
          ))}
        </div>
      </section>
    );
  })}

  {mostrarPropostas && CANDIDATOS.some((c) => resultados(c.id).length) && (
    <section>
      <h2>O que o plano diz que já foi feito</h2>
      <p class="aviso-caixa">
        São afirmações dos próprios planos sobre o passado, <strong>ainda não verificadas</strong> por este site.
        Quando houver votação ou ato oficial correspondente, ele aparece na seção “Ações e votos”.
      </p>
      <div class="lados">
        {CANDIDATOS.map((c) => (
          <div class="lado" data-cand={c.id}>
            <p class="quem"><strong>{c.nome}</strong> <span class="chip">{c.partido}</span></p>
            {resultados(c.id).length
              ? <details><summary>{resultados(c.id).length} afirmação(ões)</summary>
                  {resultados(c.id).map((p: any) => <Proposta proposta={p} docs={docs} />)}
                </details>
              : <p class="vazio">Nenhuma afirmação deste tipo registrada.</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  <h2>Falas dos candidatos</h2>
  {visivel(eixo.status.falas) && eixo.falas.length === 0
    ? <p class="vazio">Nenhuma fala registrada.</p>
    : !visivel(eixo.status.falas) && <div class="aviso-caixa">As falas sobre este tema estão <strong>em preparação</strong>.</div>}

  <h2>Ações e votos no Congresso</h2>
  {!visivel(eixo.status.acoes) && (
    <div class="aviso-caixa">
      Esta parte está <strong>em preparação</strong>. Ela vai mostrar, de forma identificada, o voto do próprio candidato,
      o voto da bancada do partido na Câmara e no Senado, e atos de governo.
    </div>
  )}
</Base>

<script is:inline>
  (function () {
    var botao = document.getElementById("inverter");
    var chave = "lados-invertidos";
    function aplicar(inv) {
      document.documentElement.classList.toggle("invertido", inv);
      if (botao) botao.setAttribute("aria-pressed", String(inv));
    }
    var inicial = false;
    try { inicial = localStorage.getItem(chave) === "1"; } catch (e) {}
    aplicar(inicial);
    if (botao) botao.addEventListener("click", function () {
      var novo = !document.documentElement.classList.contains("invertido");
      aplicar(novo);
      try { localStorage.setItem(chave, novo ? "1" : "0"); } catch (e) {}
    });
  })();
</script>

<style is:global>
  .status { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; padding: 0; margin: 1rem 0; font-size: .9rem; }
  .barra { margin: 1rem 0 0; }
  .barra button { font: inherit; font-size: .85rem; padding: .35rem .8rem; background: var(--papel); border: 1px solid var(--tinta-2); border-radius: var(--raio); color: var(--tinta); cursor: pointer; }
  .lados { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 52rem) { .lados { grid-template-columns: 1fr 1fr; } }
  html.invertido .lados .lado:first-child { order: 2; }
  .lado .quem { margin: 0 0 .6rem; padding-bottom: .35rem; border-bottom: 3px solid var(--lado-a); }
  .lado[data-cand="lula"] .quem { border-bottom-color: var(--lado-b); }
  .vazio { color: var(--texto-2); font-style: italic; }
  .topico { margin-top: 2rem; }
  details > summary { cursor: pointer; margin-bottom: .6rem; font-weight: 600; color: var(--tinta); }
</style>
